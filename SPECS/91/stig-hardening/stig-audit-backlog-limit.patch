From e21937dda25deb1bb4795a61381776404e87c65e Mon Sep 17 00:00:00 2001
From: Daniel Casota <dcasota@gmail.com>
Date: Mon, 5 Oct 2026 09:43:22 +0200
Subject: [PATCH] audit: size the kernel's audit backlog for the STIG rules

PHTN-50-000080 adds audit=1 to the kernel command line, so the kernel
queues audit records from the first boot on, before auditd runs; with the
default audit_backlog_limit (64) that queue overflows at boot ("kauditd hold
queue overflow", audit_lost=1, 2 and 50 on Photon OS 5.0 STIG guests). Add
audit_backlog_limit=8192 next to audit=1, unless the command line already
sets one.

Set -b 8192 in the audit.STIG.rules template too (used with audit older
than 3.0.9-25), the value of audit's own 10-base-config.rules sample: with
-b 640 an rpm transaction of a few hundred files overflows the queue under
the perm_mod rules and records are lost.
---
 tasks/photon.yml           | 8 ++++++++
 templates/audit.STIG.rules | 2 +-
 vars/main.yml              | 1 +
 3 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/tasks/photon.yml b/tasks/photon.yml
index 5b8c4b9..56eb82e 100644
--- a/tasks/photon.yml
+++ b/tasks/photon.yml
@@ -889,6 +889,14 @@
       when:
         - auditdinstalled.stdout != ""
 
+    - name: PHTN-50-000080 - Add audit_backlog_limit in /boot/grub2/grub.cfg
+      ansible.builtin.replace:
+        path: '{{ var_grub_conf_file }}'
+        regexp: '^(\s*linux(?!.* audit_backlog_limit=).*)'
+        replace: '\1 audit_backlog_limit={{ var_audit_backlog_limit }}'
+      when:
+        - auditdinstalled.stdout != ""
+
 ###################################################################################################################################
 - name: PHTN-50-000082 - Update permissions on auditing tools
   tags: [PHTN-50-000082]
diff --git a/templates/audit.STIG.rules b/templates/audit.STIG.rules
index 22a6ab9..3006dde 100644
--- a/templates/audit.STIG.rules
+++ b/templates/audit.STIG.rules
@@ -6,7 +6,7 @@
 
 # Increase the buffers to survive stress events.
 # Make this bigger for busy systems
--b 640
+-b 8192
 
 # PHTN-50-000003 audit useradd/groupadd commands
 -w /usr/sbin/useradd -p x -k useradd
diff --git a/vars/main.yml b/vars/main.yml
index 7ab620f..5bdfdd3 100644
--- a/vars/main.yml
+++ b/vars/main.yml
@@ -87,6 +87,7 @@ var_systemd_tmp_mount_file: '/lib/systemd/system/tmp.mount'
 var_etc_issue_file: '/etc/issue'
 var_modprobe_conf_file: '/etc/modprobe.d/modprobe.conf'
 var_grub_conf_file: '/boot/grub2/grub.cfg'
+var_audit_backlog_limit: 8192
 var_profile_tmout_sh: '/etc/profile.d/tmout.sh'
 var_tdnf_conf_file: '/etc/tdnf/tdnf.conf'
 var_systemd_resolved_conf_file: '/etc/systemd/resolved.conf'
