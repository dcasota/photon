+/*
+ * Bitfields: GCC gives a bitfield FIELD_DECL an unnamed integer type of its
+ * width ("<unnamed-unsigned:4>"); DWARF names the declared type ("u32") and
+ * gives its size. Compare declared type, its size and the width instead.
+ */
+static unsigned short kernel_bit_size(tree field)
+{
+	tree decl_type;
+	unsigned HOST_WIDE_INT width;
+
+	if (TREE_CODE(field) != FIELD_DECL || !DECL_BIT_FIELD_TYPE(field) ||
+	    !DECL_SIZE(field) || !tree_fits_uhwi_p(DECL_SIZE(field)))
+		return 0;
+
+	decl_type = DECL_BIT_FIELD_TYPE(field);
+	width = tree_to_uhwi(DECL_SIZE(field));
+	if (width == get_type_size(decl_type) * BITS_PER_UNIT)
+		return 0;
+
+	return (unsigned short)width;
+}
+
+/* Size of the field's declared type (for a bitfield: of its storage type) */
+static size_t kernel_field_size(tree field)
+{
+	if (TREE_CODE(field) == FIELD_DECL && DECL_BIT_FIELD_TYPE(field))
+		return get_type_size(DECL_BIT_FIELD_TYPE(field));
+
+	return get_field_size(field);
+}
+
+/*
+ * Arrays of anonymous structures/unions: GCC prints the whole body
+ * ("union {...}[2]"), the canister's debuginfo gives "union [2]". Render the
+ * kernel type the same way; returns false for any other type.
+ */
+static bool anon_aggregate_array_str(tree type, char *buf, int len)
+{
+	tree elem = type;
+	int n;
+
+	while (TREE_CODE(elem) == ARRAY_TYPE)
+		elem = TREE_TYPE(elem);
+	if (elem == type || TYPE_NAME(elem) ||
+	    (TREE_CODE(elem) != RECORD_TYPE && TREE_CODE(elem) != UNION_TYPE))
+		return false;
+
+	n = snprintf(buf, len, "%s ", TREE_CODE(elem) == UNION_TYPE ? "union" : "struct");
+	for (tree t = type; TREE_CODE(t) == ARRAY_TYPE && n < len; t = TREE_TYPE(t)) {
+		tree dom = TYPE_DOMAIN(t);
+
+		if (dom && TYPE_MAX_VALUE(dom) && tree_fits_uhwi_p(TYPE_MAX_VALUE(dom)))
+			n += snprintf(buf + n, len - n, "[%lu]",
+				      (unsigned long)tree_to_uhwi(TYPE_MAX_VALUE(dom)) + 1);
+		else
+			n += snprintf(buf + n, len - n, "[]");
+	}
+
+	return true;
+}
+
+/* Type string of the field's declared type */
+static void kernel_field_type_str(tree field, char *buf, int len)
+{
+	tree type = TREE_CODE(field) == FIELD_DECL ? TREE_TYPE(field) : field;
+
+	if (TREE_CODE(field) == FIELD_DECL && DECL_BIT_FIELD_TYPE(field))
+		get_field_type_str(DECL_BIT_FIELD_TYPE(field), buf, len);
+	else if (!anon_aggregate_array_str(type, buf, len))
+		get_field_type_str(field, buf, len);
+}
+
+static bool struct_has_bitfield(tree type)
+{
+	for (tree field = TYPE_FIELDS(type); field; field = TREE_CHAIN(field))
+		if (TREE_CODE(field) == FIELD_DECL && DECL_BIT_FIELD_TYPE(field))
+			return true;
+
+	return false;
+}
