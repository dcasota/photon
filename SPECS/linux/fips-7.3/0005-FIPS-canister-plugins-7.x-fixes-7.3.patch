+/*
+ * Unnamed bitfields (": 2") only reserve bits: DWARF has no member for them,
+ * so the canister's member lists do not contain them. Step over them.
+ */
+static tree skip_unnamed_bitfields(tree field)
+{
+	while (field && TREE_CODE(field) == FIELD_DECL && !DECL_NAME(field) &&
+	       DECL_BIT_FIELD_TYPE(field))
+		field = TREE_CHAIN(field);
+
+	return field;
+}
