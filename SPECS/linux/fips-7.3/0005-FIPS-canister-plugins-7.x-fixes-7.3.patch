+/*
+ * Cache file: struct cache_hdr, then the hash table and the definitions (cache
+ * offsets are relative to the table). It is published with rename(), so a
+ * reader sees a complete file or none, and it is bound to the canister object
+ * it was parsed from. Anything else is ignored and the canister is parsed again.
+ */
+#define CACHE_MAGIC "FCSDB02"
+
+struct cache_hdr {
+	char magic[8];
+	unsigned long long canister_size;
+	long long canister_mtime_sec;
+	long long canister_mtime_nsec;
+	unsigned long long payload_size;
+};
+
+static int canister_identity(struct cache_hdr *hdr)
+{
+	struct stat st;
+
+	if (stat(CANISTER_OBJ_LOC, &st) < 0)
+		return -1;
+	hdr->canister_size = st.st_size;
+	hdr->canister_mtime_sec = st.st_mtim.tv_sec;
+	hdr->canister_mtime_nsec = st.st_mtim.tv_nsec;
+	return 0;
+}
