From: Daniel Casota <dcasota@gmail.com>
Subject: [PATCH] Patch11000: 1000-FIPS-canister-creation.patch (rebuilt for 7.x: canister assembly, fcw_ routing, canister-local static keys/calls)

Linux 7.3-rc4 port of the Photon FIPS canister series.
See EXPERIMENTAL-7.3-rc4-FIPS.md for the per-patch decisions.
---
diff --git a/arch/x86/crypto/aesni-intel_glue.c b/arch/x86/crypto/aesni-intel_glue.c
index f0588604e943156f9713991373071123ad8c3306..f8830fd061c4b777113c082be56a832fd8852c13 100644
--- a/arch/x86/crypto/aesni-intel_glue.c
+++ b/arch/x86/crypto/aesni-intel_glue.c
@@ -37,7 +37,7 @@
 #include <linux/workqueue.h>
 #include <linux/spinlock.h>
 #include <linux/static_call.h>
-
+#include "../../../crypto/fips_canister_wrapper.h"\n
 
 #define AESNI_ALIGN	16
 #define AESNI_ALIGN_ATTR __attribute__ ((__aligned__(AESNI_ALIGN)))
@@ -107,9 +107,9 @@ static int aes_set_key_common(struct crypto_aes_ctx *ctx,
 	if (err)
 		return err;
 
-	kernel_fpu_begin();
+	fcw_kernel_fpu_begin();
 	aesni_set_key(ctx, in_key, key_len);
-	kernel_fpu_end();
+	fcw_kernel_fpu_end();
 	return 0;
 }
 
@@ -130,10 +130,10 @@ static int ecb_encrypt(struct skcipher_request *req)
 	err = skcipher_walk_virt(&walk, req, false);
 
 	while ((nbytes = walk.nbytes)) {
-		kernel_fpu_begin();
+		fcw_kernel_fpu_begin();
 		aesni_ecb_enc(ctx, walk.dst.virt.addr, walk.src.virt.addr,
 			      nbytes & AES_BLOCK_MASK);
-		kernel_fpu_end();
+		fcw_kernel_fpu_end();
 		nbytes &= AES_BLOCK_SIZE - 1;
 		err = skcipher_walk_done(&walk, nbytes);
 	}
@@ -152,10 +152,10 @@ static int ecb_decrypt(struct skcipher_request *req)
 	err = skcipher_walk_virt(&walk, req, false);
 
 	while ((nbytes = walk.nbytes)) {
-		kernel_fpu_begin();
+		fcw_kernel_fpu_begin();
 		aesni_ecb_dec(ctx, walk.dst.virt.addr, walk.src.virt.addr,
 			      nbytes & AES_BLOCK_MASK);
-		kernel_fpu_end();
+		fcw_kernel_fpu_end();
 		nbytes &= AES_BLOCK_SIZE - 1;
 		err = skcipher_walk_done(&walk, nbytes);
 	}
@@ -174,10 +174,10 @@ static int cbc_encrypt(struct skcipher_request *req)
 	err = skcipher_walk_virt(&walk, req, false);
 
 	while ((nbytes = walk.nbytes)) {
-		kernel_fpu_begin();
+		fcw_kernel_fpu_begin();
 		aesni_cbc_enc(ctx, walk.dst.virt.addr, walk.src.virt.addr,
 			      nbytes & AES_BLOCK_MASK, walk.iv);
-		kernel_fpu_end();
+		fcw_kernel_fpu_end();
 		nbytes &= AES_BLOCK_SIZE - 1;
 		err = skcipher_walk_done(&walk, nbytes);
 	}
@@ -196,10 +196,10 @@ static int cbc_decrypt(struct skcipher_request *req)
 	err = skcipher_walk_virt(&walk, req, false);
 
 	while ((nbytes = walk.nbytes)) {
-		kernel_fpu_begin();
+		fcw_kernel_fpu_begin();
 		aesni_cbc_dec(ctx, walk.dst.virt.addr, walk.src.virt.addr,
 			      nbytes & AES_BLOCK_MASK, walk.iv);
-		kernel_fpu_end();
+		fcw_kernel_fpu_end();
 		nbytes &= AES_BLOCK_SIZE - 1;
 		err = skcipher_walk_done(&walk, nbytes);
 	}
@@ -255,10 +255,10 @@ static int cts_cbc_encrypt(struct skcipher_request *req)
 	if (err)
 		return err;
 
-	kernel_fpu_begin();
+	fcw_kernel_fpu_begin();
 	aesni_cts_cbc_enc(ctx, walk.dst.virt.addr, walk.src.virt.addr,
 			  walk.nbytes, walk.iv);
-	kernel_fpu_end();
+	fcw_kernel_fpu_end();
 
 	return skcipher_walk_done(&walk, 0);
 }
@@ -311,10 +311,10 @@ static int cts_cbc_decrypt(struct skcipher_request *req)
 	if (err)
 		return err;
 
-	kernel_fpu_begin();
+	fcw_kernel_fpu_begin();
 	aesni_cts_cbc_dec(ctx, walk.dst.virt.addr, walk.src.virt.addr,
 			  walk.nbytes, walk.iv);
-	kernel_fpu_end();
+	fcw_kernel_fpu_end();
 
 	return skcipher_walk_done(&walk, 0);
 }
@@ -333,7 +333,7 @@ static int ctr_crypt_aesni(struct skcipher_request *req)
 	err = skcipher_walk_virt(&walk, req, false);
 
 	while ((nbytes = walk.nbytes) > 0) {
-		kernel_fpu_begin();
+		fcw_kernel_fpu_begin();
 		if (nbytes & AES_BLOCK_MASK)
 			aesni_ctr_enc(ctx, walk.dst.virt.addr,
 				      walk.src.virt.addr,
@@ -348,7 +348,7 @@ static int ctr_crypt_aesni(struct skcipher_request *req)
 			crypto_inc(walk.iv, AES_BLOCK_SIZE);
 			nbytes = 0;
 		}
-		kernel_fpu_end();
+		fcw_kernel_fpu_end();
 		err = skcipher_walk_done(&walk, nbytes);
 	}
 	return err;
@@ -415,11 +415,11 @@ xts_crypt_slowpath(struct skcipher_request *req, xts_crypt_func crypt_func)
 	err = skcipher_walk_virt(&walk, req, false);
 
 	while (walk.nbytes) {
-		kernel_fpu_begin();
+		fcw_kernel_fpu_begin();
 		(*crypt_func)(&ctx->crypt_ctx,
 			      walk.src.virt.addr, walk.dst.virt.addr,
 			      walk.nbytes & ~(AES_BLOCK_SIZE - 1), req->iv);
-		kernel_fpu_end();
+		fcw_kernel_fpu_end();
 		err = skcipher_walk_done(&walk,
 					 walk.nbytes & (AES_BLOCK_SIZE - 1));
 	}
@@ -440,10 +440,10 @@ xts_crypt_slowpath(struct skcipher_request *req, xts_crypt_func crypt_func)
 	if (err)
 		return err;
 
-	kernel_fpu_begin();
+	fcw_kernel_fpu_begin();
 	(*crypt_func)(&ctx->crypt_ctx, walk.src.virt.addr, walk.dst.virt.addr,
 		      walk.nbytes, req->iv);
-	kernel_fpu_end();
+	fcw_kernel_fpu_end();
 
 	return skcipher_walk_done(&walk, 0);
 }
@@ -459,7 +459,7 @@ xts_crypt(struct skcipher_request *req, xts_encrypt_iv_func encrypt_iv,
 	if (unlikely(req->cryptlen < AES_BLOCK_SIZE))
 		return -EINVAL;
 
-	kernel_fpu_begin();
+	fcw_kernel_fpu_begin();
 	(*encrypt_iv)(&ctx->tweak_ctx, req->iv);
 
 	/*
@@ -474,10 +474,10 @@ xts_crypt(struct skcipher_request *req, xts_encrypt_iv_func encrypt_iv,
 		   req->dst->length >= req->cryptlen)) {
 		(*crypt_func)(&ctx->crypt_ctx, sg_virt(req->src),
 			      sg_virt(req->dst), req->cryptlen, req->iv);
-		kernel_fpu_end();
+		fcw_kernel_fpu_end();
 		return 0;
 	}
-	kernel_fpu_end();
+	fcw_kernel_fpu_end();
 	return xts_crypt_slowpath(req, crypt_func);
 }
 
@@ -630,7 +630,7 @@ ctr_crypt(struct skcipher_request *req,
 		}
 		ctr64 += nblocks;
 
-		kernel_fpu_begin();
+		fcw_kernel_fpu_begin();
 		if (likely(ctr64 >= nblocks)) {
 			/* The low 64 bits of the counter won't overflow. */
 			(*ctr64_func)(key, walk.src.virt.addr,
@@ -651,7 +651,7 @@ ctr_crypt(struct skcipher_request *req,
 				      walk.dst.virt.addr + p1_nbytes,
 				      nbytes - p1_nbytes, le_ctr);
 		}
-		kernel_fpu_end();
+		fcw_kernel_fpu_end();
 		le_ctr[0] = ctr64;
 
 		err = skcipher_walk_done(&walk, walk.nbytes - nbytes);
@@ -682,10 +682,10 @@ xctr_crypt(struct skcipher_request *req,
 		if (nbytes < walk.total)
 			nbytes = round_down(nbytes, AES_BLOCK_SIZE);
 
-		kernel_fpu_begin();
+		fcw_kernel_fpu_begin();
 		(*xctr_func)(key, walk.src.virt.addr, walk.dst.virt.addr,
 			     nbytes, req->iv, ctr);
-		kernel_fpu_end();
+		fcw_kernel_fpu_end();
 
 		ctr += DIV_ROUND_UP(nbytes, AES_BLOCK_SIZE);
 		err = skcipher_walk_done(&walk, walk.nbytes - nbytes);
@@ -1200,9 +1200,9 @@ static int gcm_setkey(struct crypto_aead *tfm, const u8 *raw_key,
 		return err;
 
 	if (likely(crypto_simd_usable())) {
-		kernel_fpu_begin();
+		fcw_kernel_fpu_begin();
 		aes_gcm_precompute(key, flags);
-		kernel_fpu_end();
+		fcw_kernel_fpu_end();
 	} else {
 		static const u8 x_to_the_minus1[16] __aligned(__alignof__(be128)) = {
 			[0] = 0xc2, [15] = 1
@@ -1269,7 +1269,7 @@ static int gcm_setkey(struct crypto_aead *tfm, const u8 *raw_key,
 /*
  * Initialize @ghash_acc, then pass all @assoclen bytes of associated data
  * (a.k.a. additional authenticated data) from @sg_src through the GHASH update
- * assembly function.  kernel_fpu_begin() must have already been called.
+ * assembly function.  fcw_kernel_fpu_begin() must have already been called.
  */
 static void gcm_process_assoc(const struct aes_gcm_key *key, u8 ghash_acc[16],
 			      struct scatterlist *sg_src, unsigned int assoclen,
@@ -1318,8 +1318,8 @@ static void gcm_process_assoc(const struct aes_gcm_key *key, u8 ghash_acc[16],
 next:
 		scatterwalk_done_src(&walk, orig_len_this_step);
 		if (need_resched()) {
-			kernel_fpu_end();
-			kernel_fpu_begin();
+			fcw_kernel_fpu_end();
+			fcw_kernel_fpu_begin();
 		}
 		assoclen -= orig_len_this_step;
 	}
@@ -1373,7 +1373,7 @@ gcm_crypt(struct aead_request *req, int flags)
 	 * section and start a new one if there are multiple data segments or if
 	 * rescheduling is needed while processing the associated data.
 	 */
-	kernel_fpu_begin();
+	fcw_kernel_fpu_begin();
 
 	/* Pass the associated data through GHASH. */
 	gcm_process_assoc(key, ghash_acc, req->src, assoclen, flags);
@@ -1391,11 +1391,11 @@ gcm_crypt(struct aead_request *req, int flags)
 		aes_gcm_update(key, le_ctr, ghash_acc, walk.src.virt.addr,
 			       walk.dst.virt.addr, nbytes, flags);
 		le_ctr[0] += nbytes / AES_BLOCK_SIZE;
-		kernel_fpu_end();
+		fcw_kernel_fpu_end();
 		err = skcipher_walk_done(&walk, walk.nbytes - nbytes);
 		if (err)
 			return err;
-		kernel_fpu_begin();
+		fcw_kernel_fpu_begin();
 	}
 	/* Last segment: process all remaining data. */
 	aes_gcm_update(key, le_ctr, ghash_acc, walk.src.virt.addr,
@@ -1431,7 +1431,7 @@ gcm_crypt(struct aead_request *req, int flags)
 				       datalen, tag, taglen, flags))
 			err = -EBADMSG;
 	}
-	kernel_fpu_end();
+	fcw_kernel_fpu_end();
 	if (nbytes)
 		skcipher_walk_done(&walk, 0);
 	return err;
diff --git a/crypto/Makefile b/crypto/Makefile
index 70c40d5465fdd3e3d9e997116efba10932c2d827..1e6346e0c4c6e0c859aaa9f05ff010cc37df096b 100644
--- a/crypto/Makefile
+++ b/crypto/Makefile
@@ -189,6 +189,112 @@ obj-$(CONFIG_CRYPTO_SIMD) += crypto_simd.o
 obj-$(CONFIG_CRYPTO_KDF800108_CTR) += kdf_sp800108.o
 
 obj-$(CONFIG_CRYPTO_KRB5) += krb5/
+
+#
+# FIPS canister (canister_build): the approved algorithms, compiled from their
+# usual sources but linked into one relocatable object whose text and rodata
+# are measured by fips_integrity.c at boot.
+#
+# crypto/ members
+canister += geniv.o seqiv.o
+canister += rsapubkey.asn1.o rsaprivkey.asn1.o rsa.o rsa_helper.o rsassa-pkcs1.o
+canister += ecdsa.o ecdsa-x962.o ecdsa-p1363.o ecdsasignature.asn1.o
+canister += algboss.o testmgr.o
+canister += hmac.o cmac.o
+canister += sha256.o sha512.o sha3.o
+canister += cbc.o cts.o xts.o ctr.o gcm.o ccm.o aes.o
+canister += ecc.o drbg.o ecdh.o ecdh_helper.o
+canister += crypto_self_test.o
+canister += fips_integrity.o
+
+hostprogs := partial_reloc gen_canister_relocs
+HOSTLDLIBS_partial_reloc = -lelf
+HOSTCFLAGS_partial_reloc = -g
+HOSTLDLIBS_gen_canister_relocs = -lelf
+HOSTCFLAGS_gen_canister_relocs = -g
+
+quiet_cmd_pr = RELOC   $@
+cmd_pr = $(obj)/partial_reloc $@
+
+quiet_cmd_gencr = GENCR   $@
+cmd_gencr = $(obj)/gen_canister_relocs $< $@ $(obj)/canister_markers.lds $(obj)/fips_canister-kallsyms
+
+quiet_cmd_update_hmac = HMAC    $@
+cmd_update_hmac = $(obj)/update_canister_hmac.sh $@ $(obj)/canister_markers.lds
+
+# arch/x86/crypto members (AES-NI modes), compiled here as x86-<name>.o
+aesni-intel-y := aesni-intel_asm.o aesni-intel_glue.o
+aesni-intel-$(CONFIG_64BIT) += aes-ctr-avx-x86_64.o aes-gcm-aesni-x86_64.o \
+			       aes-gcm-vaes-avx2.o aes-gcm-vaes-avx512.o \
+			       aes-xts-avx-x86_64.o
+x86-hwaccelerated-y := $(aesni-intel-y)
+
+$(obj)/x86-%.o: $(srctree)/arch/x86/crypto/%.c FORCE
+	$(call if_changed_rule,cc_o_c)
+
+$(obj)/x86-%.o: $(srctree)/arch/x86/crypto/%.S FORCE
+	$(call if_changed_rule,as_o_S)
+
+# lib/crypto members, compiled here as lib-crypto-<name>.o; their x86 code is
+# included from lib/crypto/x86/*.h (C) or assembled as lib-crypto-x86-<name>.o
+lib-crypto-y := aes.o sha256.o sha512.o sha3.o gf128hash.o
+lib-crypto-x86-y := aes-aesni.o \
+		    sha256-ssse3-asm.o sha256-avx-asm.o sha256-avx2-asm.o sha256-ni-asm.o \
+		    sha512-ssse3-asm.o sha512-avx-asm.o sha512-avx2-asm.o \
+		    ghash-pclmul.o polyval-pclmul-avx.o
+
+$(obj)/lib-crypto-x86-%.o: $(srctree)/lib/crypto/x86/%.S FORCE
+	$(call if_changed_rule,as_o_S)
+
+$(obj)/lib-crypto-%.o: $(srctree)/lib/crypto/%.c FORCE
+	$(call if_changed_rule,cc_o_c)
+
+$(foreach o,$(lib-crypto-y),$(eval CFLAGS_lib-crypto-$(o) += -I$(srctree)/lib/crypto/$(SRCARCH) -I$(srctree)/lib/crypto))
+
+extra-y += $(canister)
+
+canister-objs := $(addprefix $(obj)/x86-,$(x86-hwaccelerated-y)) \
+		 $(addprefix $(obj)/lib-crypto-,$(lib-crypto-y)) \
+		 $(addprefix $(obj)/lib-crypto-x86-,$(lib-crypto-x86-y)) \
+		 $(addprefix $(obj)/,$(canister))
+
+$(obj)/canister.o: $(obj)/partial_reloc $(canister-objs)
+	$(Q)$(LD) -z noexecstack -T $(src)/canister_combine.lds -r $(canister-objs) -o $@
+	$(call cmd,pr)
+	@$(foreach o,$(x86-hwaccelerated-y),echo x86-$(o) > objs;)
+	@$(foreach o,$(lib-crypto-y),echo lib-crypto-$(o) >> objs;)
+	@$(foreach o,$(lib-crypto-x86-y),echo lib-crypto-x86-$(o) >> objs;)
+	@$(foreach o,$(canister),echo $(o) >> objs;)
+
+canister-cflags := -DFIPS_CANISTER -mharden-sls=all -D__NO_FORTIFY
+canister-cflags-remove := -DLATENT_ENTROPY_PLUGIN \
+	-fplugin=./scripts/gcc-plugins/latent_entropy_plugin.so \
+	-fplugin-arg-rap_plugin-check=call $(RETPOLINE_CFLAGS) $(RETHUNK_CFLAGS)
+
+$(foreach o,$(canister),$(eval CFLAGS_$(o) += $(canister-cflags)))
+$(foreach o,$(canister),$(eval CFLAGS_REMOVE_$(o) += $(canister-cflags-remove)))
+$(foreach o,$(lib-crypto-y),$(eval CFLAGS_lib-crypto-$(o) += $(canister-cflags)))
+$(foreach o,$(lib-crypto-y),$(eval CFLAGS_REMOVE_lib-crypto-$(o) += $(canister-cflags-remove)))
+$(foreach o,$(x86-hwaccelerated-y),$(eval CFLAGS_x86-$(o) += $(canister-cflags)))
+$(foreach o,$(x86-hwaccelerated-y),$(eval CFLAGS_REMOVE_x86-$(o) += $(canister-cflags-remove)))
+$(foreach o,$(x86-hwaccelerated-y),$(eval OBJECT_FILES_NON_STANDARD_x86-$(o) := y))
+$(foreach o,$(lib-crypto-x86-y),$(eval OBJECT_FILES_NON_STANDARD_lib-crypto-x86-$(o) := y))
+
+$(src)/canister_relocs.c: $(obj)/canister.o $(obj)/gen_canister_relocs
+	$(call cmd,gencr)
+clean-files += canister_relocs.c
+clean-files += fips_canister-kallsyms
+# Make savecmd_ happy for proper incremental build
+targets += canister_relocs.o $(addprefix x86-,$(x86-hwaccelerated-y)) \
+	   $(addprefix lib-crypto-,$(lib-crypto-y)) $(addprefix lib-crypto-x86-,$(lib-crypto-x86-y))
+$(obj)/canister_markers.lds: $(src)/canister_relocs.c
+
+clean-files += canister_markers.lds
+
+$(obj)/fips_canister.o: $(obj)/canister.o $(obj)/canister_relocs.o $(obj)/canister_markers.lds
+	$(Q)$(LD) -z noexecstack -T $(obj)/canister_markers.lds -r $(obj)/canister.o $(obj)/canister_relocs.o -o $@
+	$(call cmd_and_savecmd,update_hmac)
+
 obj-$(CONFIG_CRYPTO_FIPS) += fips_canister_wrapper.o fips_canister.o
 obj-$(CONFIG_CRYPTO_FIPS) += fips_canister_wrapper_internal.o
 
diff --git a/crypto/ccm.c b/crypto/ccm.c
index 916441e4f2b863a19d408364694b1f6506d314e8..bfec8ee47cb830426ef1d818de1db71907592e96 100644
--- a/crypto/ccm.c
+++ b/crypto/ccm.c
@@ -16,6 +16,7 @@
 #include <linux/module.h>
 #include <linux/slab.h>
 #include <linux/string.h>
