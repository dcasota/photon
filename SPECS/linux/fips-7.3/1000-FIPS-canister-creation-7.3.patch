diff --git a/crypto/ecc.c b/crypto/ecc.c
index 3250a464b8523aa86b525cded939f5d70b20b024..3475dacf8e797d987c26d4e53a7c6c8bfb79e44f 100644
--- a/crypto/ecc.c
