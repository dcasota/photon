diff --git a/crypto/fips_canister_static.h b/crypto/fips_canister_static.h
new file mode 100644
index 0000000000000000000000000000000000000000..3e243fe2c42161b0248985b1c7368872067a4aa5
--- /dev/null
+++ b/crypto/fips_canister_static.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Static keys and static calls inside the FIPS canister.
+ *
+ * Jump labels and static calls are patched at run time, which would change
+ * the canister text after fips_integrity_init() measured it; the canister link
+ * refuses __jump_table and friends for that reason. Code compiled into the
+ * canister (FIPS_CANISTER) that selects an implementation once at init gets
+ * the same semantics from a __ro_after_init flag or function pointer here.
+ *
+ * Include this AFTER <linux/jump_label.h> and <linux/static_call.h> and only
+ * from files whose keys and calls are private to the canister: an inline
+ * function from another header that was already parsed keeps the real
+ * primitives, and the canister link rejects the resulting patch site.
+ */
+#ifndef _FIPS_CANISTER_STATIC_H
+#define _FIPS_CANISTER_STATIC_H
+
+#ifdef FIPS_CANISTER
+#include <linux/compiler.h>
+#include <linux/types.h>
+
+#undef DEFINE_STATIC_KEY_FALSE
+#undef DEFINE_STATIC_KEY_TRUE
+#undef static_branch_likely
+#undef static_branch_unlikely
+#undef static_branch_enable
+#undef static_branch_disable
+#undef static_key_enabled
+#define DEFINE_STATIC_KEY_FALSE(name)	bool name = false
+#define DEFINE_STATIC_KEY_TRUE(name)	bool name = true
+#define static_branch_likely(key)	likely(*(key))
+#define static_branch_unlikely(key)	unlikely(*(key))
+#define static_branch_enable(key)	((void)(*(key) = true))
+#define static_branch_disable(key)	((void)(*(key) = false))
+#define static_key_enabled(key)		(*(key))
+
+#undef DEFINE_STATIC_CALL
+#undef static_call
+#undef static_call_update
+#define DEFINE_STATIC_CALL(name, _func) \
+	static typeof(&(_func)) __fips_canister_sc_##name __ro_after_init = (_func)
+#define static_call(name)		(*__fips_canister_sc_##name)
+#define static_call_update(name, _func) \
+	((void)(__fips_canister_sc_##name = (_func)))
+#endif /* FIPS_CANISTER */
+
+#endif /* _FIPS_CANISTER_STATIC_H */
