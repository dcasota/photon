-	inst = kzalloc(sizeof(*inst) + sizeof(*ictx), GFP_KERNEL);
+	inst = fcw_kzalloc(sizeof(*inst) + sizeof(*ictx), GFP_KERNEL);
 	if (!inst)
 		return -ENOMEM;
 	ictx = aead_instance_ctx(inst);
@@ -710,7 +711,7 @@ static int crypto_rfc4309_create(struct crypto_template *tmpl,
