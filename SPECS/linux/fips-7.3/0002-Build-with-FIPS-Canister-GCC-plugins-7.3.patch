diff --git a/include/crypto/hash.h b/include/crypto/hash.h
index e474f8461ea1990ee2f5357b33c4d67bd6551a7a..5b1feb6b0f6f1b8873788357966c6ad9fcbc5d66 100644
--- a/include/crypto/hash.h
+++ b/include/crypto/hash.h
@@ -193,8 +193,18 @@ struct shash_desc {
  * containing a 'struct s390_sha_ctx'.
  */
 #define SHA3_224_S390_DESCSIZE	HASH_STATE_AND_BLOCK(S390_SHA_CTX_SIZE, 144)
+/*
+ * The FIPS canister struct plugins pad struct shash_desc by 8 bytes; the
+ * nested descriptor inside an hmac() context grows by the same amount.
+ */
+#if defined(CONFIG_GCC_PLUGIN_PAD_CANISTER_STRUCTS) || \
+    defined(CONFIG_GCC_PLUGIN_MATCH_CANISTER_STRUCTS)
+#define HASH_CANISTER_DESC_PAD	8
+#else
+#define HASH_CANISTER_DESC_PAD	0
+#endif
 #define HASH_MAX_DESCSIZE	(sizeof(struct shash_desc) + \
-				 SHA3_224_S390_DESCSIZE)
+				 SHA3_224_S390_DESCSIZE + HASH_CANISTER_DESC_PAD)
 #define MAX_SYNC_HASH_REQSIZE	(sizeof(struct ahash_request) + \
 				 HASH_MAX_DESCSIZE)
 
