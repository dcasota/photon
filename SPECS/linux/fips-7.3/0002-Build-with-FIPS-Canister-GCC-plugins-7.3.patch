From: Daniel Casota <dcasota@gmail.com>
Subject: [PATCH] Patch10201: 0002-Build-with-FIPS-Canister-GCC-plugins.patch (rebased)

Linux 7.3-rc4 port of the Photon FIPS canister series.
See EXPERIMENTAL-7.3-rc4-FIPS.md for the per-patch decisions.
---
diff --git a/crypto/rsa.c b/crypto/rsa.c
index 6c7734083c986af7890ddf346675fdedfa9f64f5..b4a4bf5c29df5917190f0d4a9c42ab5d4b412501 100644
--- a/crypto/rsa.c
+++ b/crypto/rsa.c
@@ -270,9 +270,11 @@ static int rsa_set_pub_key(struct crypto_akcipher *tfm, const void *key,
 			   unsigned int keylen)
 {
 	struct rsa_mpi_key *mpi_key = akcipher_tfm_ctx(tfm);
-	struct rsa_key raw_key = {0};
+	struct rsa_key raw_key;
 	int ret;
 
+	memset(&raw_key, 0, sizeof(struct rsa_key));
+
 	/* Free the old MPI key if any */
 	rsa_free_mpi_key(mpi_key);
 
@@ -309,9 +311,11 @@ static int rsa_set_priv_key(struct crypto_akcipher *tfm, const void *key,
 			    unsigned int keylen)
 {
 	struct rsa_mpi_key *mpi_key = akcipher_tfm_ctx(tfm);
-	struct rsa_key raw_key = {0};
+	struct rsa_key raw_key;
 	int ret;
 
+	memset(&raw_key, 0, sizeof(struct rsa_key));
+
 	/* Free the old MPI key if any */
 	rsa_free_mpi_key(mpi_key);
 
