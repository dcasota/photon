@@ -1319,7 +1319,7 @@ static void gcm_process_assoc(const struct aes_gcm_key *key, u8 ghash_acc[16],
 		}
 next:
 		scatterwalk_done_src(&walk, orig_len_this_step);
-		if (need_resched()) {
+		if (fcw_need_resched()) {
 			fcw_kernel_fpu_end();
 			fcw_kernel_fpu_begin();
 		}
diff --git a/crypto/Makefile b/crypto/Makefile
index e09a82112cea54a1e1bff1dfdec67b894eff92df..63057260a2a7e0fa705472d0ed88b608e68b472e 100644
--- a/crypto/Makefile
+++ b/crypto/Makefile
@@ -220,7 +220,7 @@ quiet_cmd_gencr = GENCR   $@
 cmd_gencr = $(obj)/gen_canister_relocs $< $@ $(obj)/canister_markers.lds $(obj)/fips_canister-kallsyms
 
 quiet_cmd_update_hmac = HMAC    $@
-cmd_update_hmac = $(obj)/update_canister_hmac.sh $@ $(obj)/canister_markers.lds
+cmd_update_hmac = $(src)/update_canister_hmac.sh $@ $(obj)/canister_markers.lds
 
 # arch/x86/crypto members (AES-NI modes), compiled here as x86-<name>.o
 aesni-intel-y := aesni-intel_asm.o aesni-intel_glue.o
@@ -261,7 +261,8 @@ canister-objs := $(addprefix $(obj)/x86-,$(x86-hwaccelerated-y)) \
 $(obj)/canister.o: $(obj)/partial_reloc $(canister-objs)
 	$(Q)$(LD) -z noexecstack -T $(src)/canister_combine.lds -r $(canister-objs) -o $@
 	$(call cmd,pr)
-	@$(foreach o,$(x86-hwaccelerated-y),echo x86-$(o) > objs;)
+	@: > objs
+	@$(foreach o,$(x86-hwaccelerated-y),echo x86-$(o) >> objs;)
 	@$(foreach o,$(lib-crypto-y),echo lib-crypto-$(o) >> objs;)
 	@$(foreach o,$(lib-crypto-x86-y),echo lib-crypto-x86-$(o) >> objs;)
 	@$(foreach o,$(canister),echo $(o) >> objs;)
