From: Daniel Casota <dcasota@gmail.com>
Subject: [PATCH] Patch10004: 0001-crypto-ecb-Set-ecb-alg-flag-as-Internal.patch (rebased: 7.x registers ecb-aes-aesni directly, no __ecb simd wrapper)

Linux 7.3-rc4 port of the Photon FIPS canister series.
See EXPERIMENTAL-7.3-rc4-FIPS.md for the per-patch decisions.
---
diff --git a/arch/x86/crypto/aesni-intel_glue.c b/arch/x86/crypto/aesni-intel_glue.c
index f522fff9231e8e0b8be09482e6bb9d366515d09c..f0588604e943156f9713991373071123ad8c3306 100644
--- a/arch/x86/crypto/aesni-intel_glue.c
+++ b/arch/x86/crypto/aesni-intel_glue.c
@@ -517,6 +517,7 @@ static struct skcipher_alg aesni_skciphers[] = {
 			.cra_name		= "ecb(aes)",
 			.cra_driver_name	= "ecb-aes-aesni",
 			.cra_priority		= 400,
+			.cra_flags		= CRYPTO_ALG_FIPS_INTERNAL,
 			.cra_blocksize		= AES_BLOCK_SIZE,
 			.cra_ctxsize		= CRYPTO_AES_CTX_SIZE,
 			.cra_module		= THIS_MODULE,
diff --git a/crypto/ecb.c b/crypto/ecb.c
index cd1b20456dad2f8e95d79f2ea21a0521697d2cd8..5a9429a9cff4d18b4a47412ce77f4d11d1b97a99 100644
--- a/crypto/ecb.c
+++ b/crypto/ecb.c
@@ -12,6 +12,7 @@
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/slab.h>
+#include <linux/fips.h>
 
 static int crypto_ecb_crypt(struct crypto_cipher *cipher, const u8 *src,
 			    u8 *dst, unsigned nbytes, bool final,
@@ -126,6 +127,14 @@ static struct lskcipher_instance *lskcipher_alloc_instance_simple2(
 	inst->free = lskcipher_free_instance_simple2;
 
 	/* Default algorithm properties, can be overridden */
+	/*
+	 * Mark ECB as Internal as it is outside FIPS canister and
+	 * there is no requirement for the ECB to be exposed to user space
+	 * through AF_ALG
+	 */
+	if (fips_enabled)
+		inst->alg.co.base.cra_flags |= CRYPTO_ALG_FIPS_INTERNAL;
+
 	inst->alg.co.base.cra_blocksize = cipher_alg->cra_blocksize;
 	inst->alg.co.base.cra_alignmask = cipher_alg->cra_alignmask;
 	inst->alg.co.base.cra_priority = cipher_alg->cra_priority;
@@ -189,6 +198,9 @@ static int crypto_ecb_create(struct crypto_template *tmpl, struct rtattr **tb)
 	if (cipher_alg->co.ivsize)
 		return -EINVAL;
 
+	if (fips_enabled)
+		inst->alg.co.base.cra_flags |= CRYPTO_ALG_FIPS_INTERNAL;
+
 	inst->alg.co.base.cra_ctxsize = cipher_alg->co.base.cra_ctxsize;
 	inst->alg.setkey = cipher_alg->setkey;
 	inst->alg.encrypt = cipher_alg->encrypt;
diff --git a/crypto/skcipher.c b/crypto/skcipher.c
index 617e840432b175c1ef979d0c9f621c9ef1258dae..7e2e7dc9a96c56f0fc54b34ae4ab8e119b6e1601 100644
--- a/crypto/skcipher.c
+++ b/crypto/skcipher.c
@@ -23,6 +23,8 @@
 #include <linux/slab.h>
 #include <linux/string.h>
 #include <linux/string_choices.h>
+#include <linux/fips.h>
+#include <linux/crypto.h>
 #include <net/netlink.h>
 #include "skcipher.h"
 
@@ -718,6 +720,12 @@ int crypto_register_skcipher(struct skcipher_alg *alg)
 	struct crypto_alg *base = &alg->base;
 	int err;
 
+	/* ECB is not exposed through AF_ALG when fips_enabled is set. */
+	if (unlikely(!fips_enabled &&
+			strnstr(base->cra_driver_name, "ecb-aes-aesni",
+			CRYPTO_MAX_ALG_NAME)))
+		base->cra_flags &= ~CRYPTO_ALG_FIPS_INTERNAL;
+
 	err = skcipher_prepare_alg(alg);
 	if (err)
 		return err;
