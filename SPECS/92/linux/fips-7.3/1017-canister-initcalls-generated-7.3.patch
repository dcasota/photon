From: Daniel Casota <dcasota@gmail.com>
Subject: [PATCH] canister (7.x): initcalls generated from the canister object; wrapper runs integrity check and self-tests at late_initcall_sync

Linux 7.3-rc4 port of the Photon FIPS canister series.
See EXPERIMENTAL-7.3-rc4-FIPS.md for the per-patch decisions.
---
diff --git a/arch/x86/crypto/aesni-intel_glue.c b/arch/x86/crypto/aesni-intel_glue.c
index 73a35041cc86c3dafb2d3a1ef11d4c9390a6e84f..6186bd83d94badfb9a5354165a825e6e9fdac3eb 100644
--- a/arch/x86/crypto/aesni-intel_glue.c
+++ b/arch/x86/crypto/aesni-intel_glue.c
@@ -37,7 +37,7 @@
 #include <linux/jump_label.h>
 #include <linux/workqueue.h>
 #include <linux/spinlock.h>
-#include "../../../crypto/fips_canister_wrapper.h"\n
+#include "../../../crypto/fips_canister_wrapper.h"
 
 #define AESNI_ALIGN	16
 #define AESNI_ALIGN_ATTR __attribute__ ((__aligned__(AESNI_ALIGN)))
diff --git a/crypto/testmgr.c b/crypto/testmgr.c
index 07de7b435b1c80b83be82ec4381c24a172788f96..a3caa6285faa4a8193e657efbf11d76ad404b429 100644
--- a/crypto/testmgr.c
+++ b/crypto/testmgr.c
@@ -17,6 +17,7 @@
  */
 
 #include <crypto/aead.h>
+#include <crypto/internal/aead.h>
 #include <crypto/hash.h>
 #include <crypto/skcipher.h>
 #include <linux/err.h>
diff --git a/include/linux/init.h b/include/linux/init.h
index 6326c61e2332d1993efae09456711fcd406a97d7..3849608a04b5ea60bbf9830c066d5cdd2cc09de0 100644
--- a/include/linux/init.h
+++ b/include/linux/init.h
@@ -274,7 +274,30 @@ extern struct module __this_module;
 #define ___define_initcall(fn, id, __sec)			\
 	__unique_initcall(fn, id, __sec, __initcall_id(fn))
 
+#ifdef FIPS_CANISTER
+/*
+ * FIPS canister: no .initcall sections inside the measured object. Each
+ * initcall gets a global trampoline named after the object and function, and
+ * "id|trampoline" is recorded in .discard.fips_canister_initcalls;
+ * crypto/gen_canister_initcalls.sh turns the records of fips_canister.o into
+ * initcalls of the same levels in fips_canister_initcalls.c, outside it.
+ */
+#define __fips_canister_initcall_name(fn)				\
+	__PASTE(__fcw_initcall_, __PASTE(__KBUILD_MODNAME, __PASTE(__, fn)))
+#define __define_initcall(fn, id)					\
+	int __init __fips_canister_initcall_name(fn)(void);		\
+	int __init __fips_canister_initcall_name(fn)(void)		\
+	{								\
+		return fn();						\
+	}								\
+	asm(".pushsection .discard.fips_canister_initcalls,\"\",@progbits\n\t" \
+	    ".ascii \"" #id "|"					\
+	    __stringify(__fips_canister_initcall_name(fn)) "\\n\"\n\t"	\
+	    ".popsection");						\
+	static_assert(__same_type(initcall_t, &fn));
+#else
 #define __define_initcall(fn, id) ___define_initcall(fn, id, .initcall##id)
+#endif
 
 /*
  * Early initcalls run before initializing SMP.
