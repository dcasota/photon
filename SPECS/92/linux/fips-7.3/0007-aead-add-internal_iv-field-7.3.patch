From: Daniel Casota <dcasota@gmail.com>
Subject: [PATCH] Patch10107: 0007-aead-add-internal_iv-field.patch (rebased: crypto_stdrng_get_bytes, no sleeping under spinlock)

Linux 7.3-rc4 port of the Photon FIPS canister series.
See EXPERIMENTAL-7.3-rc4-FIPS.md for the per-patch decisions.
---
diff --git a/crypto/aead.c b/crypto/aead.c
index 045b74c3779f4527b2e7c064af0ec77f4a81ec00..73912506fc8d7aaa1dbfdd13e040befcda4c6421 100644
--- a/crypto/aead.c
+++ b/crypto/aead.c
@@ -17,6 +17,7 @@
 #include <linux/seq_file.h>
 #include <linux/string.h>
 #include <linux/string_choices.h>
+#include <crypto/rng.h>
 #include <net/netlink.h>
 
 #include "internal.h"
@@ -309,5 +310,56 @@ int aead_register_instance(struct crypto_template *tmpl,
 }
 EXPORT_SYMBOL_GPL(aead_register_instance);
 
+static u8 internal_iv_magic;
+static DEFINE_SPINLOCK(internal_iv_magic_lock);
+
+/*
+ * 7.x: the default RNG is reached through crypto_stdrng_get_bytes(), which may
+ * sleep (it takes a mutex), so the magic is drawn before the spinlock is taken
+ * and installed under it only if no other caller installed one first.
+ */
+int aead_request_mark_internal_iv(struct aead_request *req)
+{
+	unsigned long flags;
+	u8 magic;
+	int err;
+
+	spin_lock_irqsave(&internal_iv_magic_lock, flags);
+	magic = internal_iv_magic;
+	spin_unlock_irqrestore(&internal_iv_magic_lock, flags);
+
+	while (!magic) {
+		u8 candidate = 0;
+
+		err = crypto_stdrng_get_bytes(&candidate, sizeof(candidate));
+		if (err)
+			return err;
+		if (!candidate)
+			continue;
+		spin_lock_irqsave(&internal_iv_magic_lock, flags);
+		if (!internal_iv_magic)
+			internal_iv_magic = candidate;
+		magic = internal_iv_magic;
+		spin_unlock_irqrestore(&internal_iv_magic_lock, flags);
+	}
+
+	req->internal_iv = magic;
+	return 0;
+}
+
+int aead_request_is_internal_iv(struct aead_request *req) {
+	unsigned long flags;
+	int ret;
+
+	if(!req->internal_iv)
+		return 0;
+
+	spin_lock_irqsave(&internal_iv_magic_lock, flags);
+	ret = (req->internal_iv == internal_iv_magic);
+	spin_unlock_irqrestore(&internal_iv_magic_lock, flags);
+
+	return ret;
+}
+
 MODULE_LICENSE("GPL");
 MODULE_DESCRIPTION("Authenticated Encryption with Associated Data (AEAD)");
diff --git a/include/crypto/aead.h b/include/crypto/aead.h
index 8e66a1fa9c786758c065c54b38ff1d69829f3c51..ccfb7fffafc14f3affea6305cca6e2d0e25d91ce 100644
--- a/include/crypto/aead.h
+++ b/include/crypto/aead.h
@@ -85,6 +85,7 @@ struct scatterlist;
  *	@iv: Initialisation vector
  *	@src: Source data
  *	@dst: Destination data
+ *	@internal_iv: Marks IV as internal
  *	@__ctx: Start of private context data
  */
 struct aead_request {
@@ -98,6 +99,8 @@ struct aead_request {
 	struct scatterlist *src;
 	struct scatterlist *dst;
 
+	u8 internal_iv;
+
 	void *__ctx[] CRYPTO_MINALIGN_ATTR;
 };
 
@@ -520,7 +523,7 @@ static inline struct aead_request *aead_request_alloc(struct crypto_aead *tfm,
 {
 	struct aead_request *req;
 
-	req = kmalloc(sizeof(*req) + crypto_aead_reqsize(tfm), gfp);
+	req = kzalloc(sizeof(*req) + crypto_aead_reqsize(tfm), gfp);
 
 	if (likely(req))
 		aead_request_set_tfm(req, tfm);
diff --git a/include/crypto/internal/aead.h b/include/crypto/internal/aead.h
index 28a95eb3182d06ec44b0dd788b5fa1bb650248a4..547bd79d747e813c6c523919ad91872fb5f925cf 100644
--- a/include/crypto/internal/aead.h
+++ b/include/crypto/internal/aead.h
@@ -163,6 +163,9 @@ int crypto_register_aeads(struct aead_alg *algs, int count);
 void crypto_unregister_aeads(struct aead_alg *algs, int count);
 int aead_register_instance(struct crypto_template *tmpl,
 			   struct aead_instance *inst);
+int aead_request_is_internal_iv(struct aead_request *req);
+int aead_request_mark_internal_iv(struct aead_request *req);
+
 
 #endif	/* _CRYPTO_INTERNAL_AEAD_H */
 
